# Inicio de sesión con Microsoft Entra External ID.
# Copia este archivo como .env.local (excluido de git) y completa los valores del tenant.
# Si las tres primeras variables están vacías, Habita no pide iniciar sesión y usa la API en modo Development.
# Estos valores no son secretos: quedan visibles en el código que descarga el navegador.

# Application (client) ID de la app "Habita Web" (SPA).
VITE_ENTRA_CLIENT_ID=

# https://<subdominio>.ciamlogin.com/
VITE_ENTRA_AUTHORITY=

# Permiso expuesto por la app "Habita API": api://<client-id de Habita API>/access_as_user
VITE_ENTRA_API_SCOPE=

# Opcional. Debe coincidir con una URI de redirección de la app SPA. Por defecto: el origen con "/" al final.
VITE_ENTRA_REDIRECT_URI=
