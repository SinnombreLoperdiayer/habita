{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "EntraExternalId",
    "EntraExternalId": {
      "Authority": "",
      "Audience": ""
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "Initialize": "None"
  },
  "Storage": {
    "AudioPath": "data/audio"
  },
  "Ai": {
    "Provider": "auto"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "TranscribeDeployment": "gpt-4o-transcribe",
    "ChatDeployment": "gpt-4o"
  },
  "Processing": {
    "TranscriptionConcurrency": 3,
    "DraftingConcurrency": 4,
    "TranscriptionAttempts": 3
  }
}
